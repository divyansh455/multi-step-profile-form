# Node modules dependencies
# These folders contain thousands of files and are re-installed using npm install
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment variables
# These files contain sensitive information like database passwords and API keys
# They should never be committed to version control.


# Log files
# These are generated during runtime and don't need to be tracked.
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output (optional)
# If your frontend has a build step (like 'npm run build'), ignore the output folder.

# backend/dist/ # Uncomment if your backend has a build step

# Uploads directory (optional, but recommended)
# If you store user uploads locally on the server during development,
# you usually don't want these temporary/test files in your repository.
# Keep this line if you don't want uploaded images in your repo.


# OS generated files
# Files generated by macOS or Windows that aren't part of the project code.
.DS_Store
Thumbs.db
